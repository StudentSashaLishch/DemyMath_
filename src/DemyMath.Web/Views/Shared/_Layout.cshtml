@using System.Globalization
@using DemyMath.Web
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> T

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @T["AppName"]</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/DemyMath.styles.css"
          asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom mb-4">
            <div class="container">
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">@T["AppName"]</a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">@T["Home"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">@T["About"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Learning"
                               asp-action="Index">
                                @T["Learning"]
                            </a>
                        </li>
                    </ul>

                    <form asp-controller="Language"
                          asp-action="SetLanguage"
                          method="post"
                          class="d-flex align-items-center gap-2">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="returnUrl"
                               value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />

                        <label for="languageSelect"
                               class="form-label mb-0">
                            @T["Language"]
                        </label>

                        <select id="languageSelect"
                                name="culture"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">
                            <option value="uk"
                                    selected="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "uk")">
                                @T["Ukrainian"]
                            </option>
                            <option value="en"
                                    selected="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en")">
                                @T["English"]
                            </option>
                        </select>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <main class="container pb-4">
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted">
        <div class="container">
            <span>@T["AppName"]</span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
