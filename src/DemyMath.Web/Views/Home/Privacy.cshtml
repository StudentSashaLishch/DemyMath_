@{
    ViewData["Title"] = T["PrivacyTitle"];
}

<div class="container py-4">
    <h1 class="mb-4">@T["PrivacyTitle"]</h1>

    <p class="lead">@T["PrivacyIntroduction"]</p>

    <section class="mt-4">
        <h2 class="h4">@T["PrivacyDataTitle"]</h2>
        <p>@T["PrivacyDataDescription"]</p>
    </section>

    <section class="mt-4">
        <h2 class="h4">@T["PrivacyPurposeTitle"]</h2>
        <p>@T["PrivacyPurposeDescription"]</p>
    </section>

    <section class="mt-4">
        <h2 class="h4">@T["PrivacySecurityTitle"]</h2>
        <p>@T["PrivacySecurityDescription"]</p>
    </section>

    <section class="mt-4">
        <h2 class="h4">@T["PrivacyCookiesTitle"]</h2>
        <p>@T["PrivacyCookiesDescription"]</p>
    </section>

    <section class="mt-4">
        <h2 class="h4">@T["PrivacyControlTitle"]</h2>
        <p>@T["PrivacyControlDescription"]</p>
    </section>
</div>