@page
@model LoginModel

@{
    ViewData["Title"] = T["Login"];
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6 col-lg-4">
        <section>
            <form id="account" method="post">
                <h2>@T["LoginHeading"]</h2>
                <hr />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"
                     role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                    <label asp-for="Input.Email">@T["Email"]</label>
                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <div class="input-group">
                        <div class="form-floating">
                            <input asp-for="Input.Password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   aria-required="true"
                                   placeholder="Password"
                                   id="loginPassword" />
                            <label for="loginPassword">@T["Password"]</label>
                        </div>

                        <button class="btn btn-outline-secondary"
                                type="button"
                                data-password-toggle="loginPassword"
                                aria-label="@T["ShowPassword"]"
                                aria-pressed="false">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.Password"
                          class="text-danger"></span>
                </div>

                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input"
                               asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <button id="login-submit"
                        type="submit"
                        class="w-100 btn btn-lg btn-primary">
                    @T["Login"]
                </button>

                <div class="mt-3">
                    <p>
                        <a id="forgot-password"
                           asp-page="./ForgotPassword">
                            @T["ForgotPassword"]
                        </a>
                    </p>
                    <p>
                        <a asp-page="./Register"
                           asp-route-returnUrl="@Model.ReturnUrl">
                            @T["Register"]
                        </a>
                    </p>
                    <p>
                        <a id="resend-confirmation"
                           asp-page="./ResendEmailConfirmation">
                            @T["ResendEmailConfirmation"]
                        </a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />

        <script>
            document.querySelectorAll('[data-password-toggle]').forEach(button => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(
                        button.dataset.passwordToggle
                    );

                    if (!input) {
                        return;
                    }

                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';

                    const icon = button.querySelector('i');

                    icon.classList.toggle('bi-eye', !isPassword);
                    icon.classList.toggle('bi-eye-slash', isPassword);

                    button.setAttribute(
                        'aria-label',
                        isPassword
                            ? '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["HidePassword"].Value))'
                            : '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["ShowPassword"].Value))'
                    );

                    button.setAttribute('aria-pressed', String(isPassword));
                });
            });
        </script>
}