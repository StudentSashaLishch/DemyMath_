@page
@model RegisterModel

@{
    ViewData["Title"] = T["Register"];
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6 col-lg-4">
        <form id="registerForm"
              asp-route-returnUrl="@Model.ReturnUrl"
              method="post">

            <h2>@T["RegisterHeading"]</h2>
            <hr />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />
                <label asp-for="Input.Email">@T["Email"]</label>
                <span asp-validation-for="Input.Email"
                      class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <div class="input-group">
                    <div class="form-floating">
                        <input asp-for="Input.Password"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Password"
                               id="registerPassword" />
                        <label for="registerPassword">@T["Password"]</label>
                    </div>

                    <button class="btn btn-outline-secondary"
                            type="button"
                            data-password-toggle="registerPassword"
                            aria-label="@T["ShowPassword"]"
                            aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>

                <span asp-validation-for="Input.Password"
                      class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <div class="input-group">
                    <div class="form-floating">
                        <input asp-for="Input.ConfirmPassword"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Confirm Password"
                               id="confirmPassword" />
                        <label for="confirmPassword">
                            @T["ConfirmPassword"]
                        </label>
                    </div>

                    <button class="btn btn-outline-secondary"
                            type="button"
                            data-password-toggle="confirmPassword"
                            aria-label="@T["ShowPassword"]"
                            aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>

                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger"></span>
            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="w-100 btn btn-lg btn-primary">
                @T["Register"]
            </button>
        </form>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />

        <script>
            document.querySelectorAll('[data-password-toggle]').forEach(button => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(
                        button.dataset.passwordToggle
                    );

                    if (!input) {
                        return;
                    }

                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';

                    const icon = button.querySelector('i');

                    icon.classList.toggle('bi-eye', !isPassword);
                    icon.classList.toggle('bi-eye-slash', isPassword);

                    button.setAttribute(
                        'aria-label',
                        isPassword
                            ? '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["HidePassword"].Value))'
                            : '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["ShowPassword"].Value))'
                    );

                    button.setAttribute('aria-pressed', String(isPassword));
                });
            });
        </script>
}